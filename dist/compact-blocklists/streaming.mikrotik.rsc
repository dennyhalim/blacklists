# RouterOS DNS static NXDOMAIN rules
/ip dns static add regexp="(^|\\.)(netflix\.com|nflxso\.net|nflximg\.com|netflix\.net|nflxvideo\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(ibyteimg\.com|byteoversea\.com|nflxext\.com|byteimg\.com|nflximg\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(netflix\.ca|nflxsearch\.net|netflix\.com\.edgesuite\.net|amazonaws\.com|tv\.apple\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(hls\-svod\.itunes\.apple\.com|youtube\.com|googlevideo\.com|av\-na\.amazon\.com|atv\-ps\.amazon\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(atv\-ext\.amazon\.com|tv\.v\.aaplimg\.com|hls\-svod\-ve\.itunes\.g\.aaplimg\.com|hls\-svod\-aoc\-ve\.itunes\.g\.aaplimg\.com|youtu\.be)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tiktok\.com|pv\-cdn\.net|tiktokcdn\.com|tiktokv\.com|vimeo\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(amazonvideo\.com|edgesuite\.net|ytimg\.com|globalvideo\.cdn\.pandora\.intl\.xiaomi\.com|youtube\-nocookie\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(ttlivecdn\.com\.c\.bytefcdn\-oversea\.com|twitch\.tv|ttvnw\.net|yt3\.ggpht\.com|tiktokcdn\-us\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(byteoversea\.net|douyincdn\.com|capcutapi\.com|kwai\-pro\.com|tiktokv\.eu)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tiktokcdn\-eu\.com|dailymotion\.com|kwai\.net|capcut\.com|byteglb\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(fast\.com|kwaipros\.com|plex\.direct|primevideo\.com|kick\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(bamgrid\.com|disneyplus\.com|tiktok\.tps\.dv\.tech|xiaohongshu\.com|tubi\.io)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(kwai\.com|amemv\.com|inkuai\.com|douyin\.com|tiktokrow\-cdn\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(douyinvod\.com|zijieapi\.com|samsungcloud\.tv|play\.mercadolibre\.com\.mx|kslawin\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(mythad\.com|adaether\.com|ap4r\.com|pluto\.tv|plex\.tv)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(aiv\-delivery\.net|max\.com|discomax\.com|paramountplus\.com|yximgs\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(crunchyroll\.com|peacocktv\.com|xxpkg\.com|indazn\.com|vimeocdn\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(snssdk\.com|kuaishou\.com|mydramawave\.com|rumble\.com|like\.video)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(hbomax\.com|ksapisrv\.com|douyinpic\.com|ttlivecdn\.com|dssott\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(jtvnw\.net|tmtreader\.com|bigolive\.tv|tiktokcdn\-eu\.com\.ttdns3\.com|douyinliving\.com)$" type=NXDOMAIN comment="streaming"
