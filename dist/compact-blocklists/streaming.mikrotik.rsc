# RouterOS DNS static NXDOMAIN rules
/ip dns static add regexp="(^|\\.)(netflix\.com|nflxso\.net|nflximg\.com|nflxvideo\.net|ibyteimg\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(netflix\.net|byteoversea\.com|nflxext\.com|byteimg\.com|nflximg\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(netflix\.ca|nflxsearch\.net|netflix\.com\.edgesuite\.net|amazonaws\.com|youtube\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tv\.apple\.com|hls\-svod\.itunes\.apple\.com|googlevideo\.com|av\-na\.amazon\.com|atv\-ps\.amazon\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(atv\-ext\.amazon\.com|tv\.v\.aaplimg\.com|hls\-svod\-ve\.itunes\.g\.aaplimg\.com|hls\-svod\-aoc\-ve\.itunes\.g\.aaplimg\.com|youtu\.be)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(pv\-cdn\.net|tiktok\.com|tiktokcdn\.com|tiktokv\.com|amazonvideo\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(vimeo\.com|edgesuite\.net|ytimg\.com|youtube\-nocookie\.com|globalvideo\.cdn\.pandora\.intl\.xiaomi\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(twitch\.tv|ttlivecdn\.com\.c\.bytefcdn\-oversea\.com|ttvnw\.net|yt3\.ggpht\.com|tiktokcdn\-us\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(byteoversea\.net|douyincdn\.com|capcutapi\.com|plex\.direct|kwai\-pro\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tiktokcdn\-eu\.com|tiktokv\.eu|dailymotion\.com|kwai\.net|capcut\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(fast\.com|byteglb\.com|primevideo\.com|bamgrid\.com|kick\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tiktok\.tps\.dv\.tech|disneyplus\.com|tubi\.io|xiaohongshu\.com|kwaipros\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(amemv\.com|inkuai\.com|kwai\.com|douyin\.com|zijieapi\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tiktokrow\-cdn\.com|samsungcloud\.tv|play\.mercadolibre\.com\.mx|max\.com|kslawin\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(mythad\.com|paramountplus\.com|douyinvod\.com|ap4r\.com|adaether\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(pluto\.tv|aiv\-delivery\.net|plex\.tv|discomax\.com|douyinliving\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(peacocktv\.com|indazn\.com|yximgs\.com|crunchyroll\.com|mydramawave\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(xxpkg\.com|rumble\.com|vimeocdn\.com|hbomax\.com|snssdk\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(kuaishou\.com|ksapisrv\.com|douyinpic\.com|ttlivecdn\.com|dssott\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(like\.video|jtvnw\.net|tiktokcdn\-eu\.com\.ttdns3\.com|tmtreader\.com|plex\.bz)$" type=NXDOMAIN comment="streaming"
