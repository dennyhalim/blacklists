# RouterOS DNS static NXDOMAIN rules
/ip dns static add regexp="(^|\\.)(netflix\.com|nflxso\.net|nflximg\.com|netflix\.net|nflxvideo\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(ibyteimg\.com|byteoversea\.com|nflxext\.com|byteimg\.com|nflximg\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(netflix\.ca|nflxsearch\.net|netflix\.com\.edgesuite\.net|amazonaws\.com|tv\.apple\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(hls\-svod\.itunes\.apple\.com|youtube\.com|googlevideo\.com|av\-na\.amazon\.com|atv\-ps\.amazon\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(atv\-ext\.amazon\.com|tv\.v\.aaplimg\.com|hls\-svod\-ve\.itunes\.g\.aaplimg\.com|hls\-svod\-aoc\-ve\.itunes\.g\.aaplimg\.com|youtu\.be)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tiktok\.com|pv\-cdn\.net|tiktokcdn\.com|tiktokv\.com|vimeo\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(amazonvideo\.com|edgesuite\.net|ytimg\.com|globalvideo\.cdn\.pandora\.intl\.xiaomi\.com|youtube\-nocookie\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(ttlivecdn\.com\.c\.bytefcdn\-oversea\.com|twitch\.tv|yt3\.ggpht\.com|ttvnw\.net|tiktokcdn\-us\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(capcutapi\.com|byteoversea\.net|douyincdn\.com|kwai\-pro\.com|dailymotion\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tiktokv\.eu|tiktokcdn\-eu\.com|byteglb\.com|kwai\.net|kwaipros\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(capcut\.com|fast\.com|primevideo\.com|kick\.com|bamgrid\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(disneyplus\.com|plex\.direct|tiktok\.tps\.dv\.tech|xiaohongshu\.com|kwai\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(amemv\.com|inkuai\.com|tubi\.io|douyinvod\.com|tiktokrow\-cdn\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(douyin\.com|kslawin\.com|zijieapi\.com|play\.mercadolibre\.com\.mx|mythad\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(samsungcloud\.tv|adaether\.com|ap4r\.com|plex\.tv|pluto\.tv)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(aiv\-delivery\.net|discomax\.com|yximgs\.com|max\.com|crunchyroll\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(xxpkg\.com|vimeocdn\.com|peacocktv\.com|kuaishou\.com|snssdk\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(paramountplus\.com|hbomax\.com|like\.video|rumble\.com|mydramawave\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(indazn\.com|ksapisrv\.com|douyinpic\.com|ttlivecdn\.com|jtvnw\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(dssott\.com|bigolive\.tv|tiktokcdn\-eu\.com\.ttdns3\.com|bigo\.sg|plex\.bz)$" type=NXDOMAIN comment="streaming"
