# RouterOS DNS static NXDOMAIN rules
/ip dns static add regexp="(^|\\.)(netflix\.com|nflxso\.net|nflximg\.com|netflix\.net|nflxvideo\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(ibyteimg\.com|byteoversea\.com|nflxext\.com|byteimg\.com|nflximg\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(netflix\.ca|nflxsearch\.net|netflix\.com\.edgesuite\.net|amazonaws\.com|youtube\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tv\.apple\.com|hls\-svod\.itunes\.apple\.com|googlevideo\.com|av\-na\.amazon\.com|atv\-ps\.amazon\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(atv\-ext\.amazon\.com|tv\.v\.aaplimg\.com|hls\-svod\-ve\.itunes\.g\.aaplimg\.com|hls\-svod\-aoc\-ve\.itunes\.g\.aaplimg\.com|youtu\.be)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(pv\-cdn\.net|tiktok\.com|tiktokcdn\.com|tiktokv\.com|amazonvideo\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(vimeo\.com|edgesuite\.net|ytimg\.com|youtube\-nocookie\.com|globalvideo\.cdn\.pandora\.intl\.xiaomi\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(twitch\.tv|ttlivecdn\.com\.c\.bytefcdn\-oversea\.com|ttvnw\.net|yt3\.ggpht\.com|tiktokcdn\-us\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(byteoversea\.net|douyincdn\.com|capcutapi\.com|kwai\-pro\.com|dailymotion\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tiktokcdn\-eu\.com|tiktokv\.eu|kwai\.net|capcut\.com|byteglb\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(fast\.com|plex\.direct|primevideo\.com|kick\.com|bamgrid\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(kwaipros\.com|disneyplus\.com|tiktok\.tps\.dv\.tech|tubi\.io|xiaohongshu\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(kwai\.com|amemv\.com|inkuai\.com|douyin\.com|tiktokrow\-cdn\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(zijieapi\.com|douyinvod\.com|samsungcloud\.tv|play\.mercadolibre\.com\.mx|kslawin\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(mythad\.com|adaether\.com|ap4r\.com|pluto\.tv|max\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(paramountplus\.com|aiv\-delivery\.net|plex\.tv|discomax\.com|yximgs\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(peacocktv\.com|crunchyroll\.com|indazn\.com|xxpkg\.com|vimeocdn\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(mydramawave\.com|rumble\.com|snssdk\.com|kuaishou\.com|douyinliving\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(hbomax\.com|like\.video|douyinpic\.com|ksapisrv\.com|ttlivecdn\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(dssott\.com|jtvnw\.net|tmtreader\.com|tiktokcdn\-eu\.com\.ttdns3\.com|bigolive\.tv)$" type=NXDOMAIN comment="streaming"
