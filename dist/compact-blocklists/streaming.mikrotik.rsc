# RouterOS DNS static NXDOMAIN rules
/ip dns static add regexp="(^|\\.)(netflix\.com|nflxso\.net|nflximg\.com|nflxvideo\.net|ibyteimg\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(netflix\.net|byteoversea\.com|nflxext\.com|byteimg\.com|nflximg\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(netflix\.ca|nflxsearch\.net|netflix\.com\.edgesuite\.net|amazonaws\.com|youtube\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tv\.apple\.com|hls\-svod\.itunes\.apple\.com|googlevideo\.com|av\-na\.amazon\.com|atv\-ps\.amazon\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(atv\-ext\.amazon\.com|tv\.v\.aaplimg\.com|hls\-svod\-ve\.itunes\.g\.aaplimg\.com|hls\-svod\-aoc\-ve\.itunes\.g\.aaplimg\.com|pv\-cdn\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(youtu\.be|tiktok\.com|tiktokcdn\.com|amazonvideo\.com|tiktokv\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(vimeo\.com|edgesuite\.net|ytimg\.com|youtube\-nocookie\.com|globalvideo\.cdn\.pandora\.intl\.xiaomi\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(twitch\.tv|ttlivecdn\.com\.c\.bytefcdn\-oversea\.com|ttvnw\.net|yt3\.ggpht\.com|tiktokcdn\-us\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(byteoversea\.net|douyincdn\.com|plex\.direct|capcutapi\.com|kwai\-pro\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tiktokcdn\-eu\.com|tiktokv\.eu|dailymotion\.com|kwai\.net|capcut\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(fast\.com|byteglb\.com|bamgrid\.com|primevideo\.com|kick\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tubi\.io|tiktok\.tps\.dv\.tech|disneyplus\.com|max\.com|xiaohongshu\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(amemv\.com|inkuai\.com|kwai\.com|paramountplus\.com|douyin\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(zijieapi\.com|kwaipros\.com|samsungcloud\.tv|tiktokrow\-cdn\.com|play\.mercadolibre\.com\.mx)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(mythad\.com|kslawin\.com|pluto\.tv|ap4r\.com|adaether\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(douyinvod\.com|douyinliving\.com|aiv\-delivery\.net|plex\.tv|indazn\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(discomax\.com|peacocktv\.com|yximgs\.com|mydramawave\.com|crunchyroll\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(hbomax\.com|xxpkg\.com|rumble\.com|vimeocdn\.com|snssdk\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(kuaishou\.com|ksapisrv\.com|douyinpic\.com|tiktokcdn\-eu\.com\.ttdns3\.com|dssott\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(ttlivecdn\.com|jtvnw\.net|like\.video|tmtreader\.com|plex\.bz)$" type=NXDOMAIN comment="streaming"
