# RouterOS DNS static NXDOMAIN rules
/ip dns static add regexp="(^|\\.)(netflix\.com|nflxso\.net|nflximg\.com|nflxvideo\.net|ibyteimg\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(netflix\.net|byteoversea\.com|nflxext\.com|byteimg\.com|nflximg\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(netflix\.ca|nflxsearch\.net|netflix\.com\.edgesuite\.net|amazonaws\.com|youtube\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tv\.apple\.com|hls\-svod\.itunes\.apple\.com|googlevideo\.com|av\-na\.amazon\.com|atv\-ps\.amazon\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(atv\-ext\.amazon\.com|tv\.v\.aaplimg\.com|hls\-svod\-ve\.itunes\.g\.aaplimg\.com|hls\-svod\-aoc\-ve\.itunes\.g\.aaplimg\.com|pv\-cdn\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(youtu\.be|tiktok\.com|tiktokcdn\.com|amazonvideo\.com|tiktokv\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(vimeo\.com|edgesuite\.net|ytimg\.com|youtube\-nocookie\.com|twitch\.tv)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(globalvideo\.cdn\.pandora\.intl\.xiaomi\.com|ttlivecdn\.com\.c\.bytefcdn\-oversea\.com|ttvnw\.net|yt3\.ggpht\.com|tiktokcdn\-us\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(byteoversea\.net|plex\.direct|douyincdn\.com|capcutapi\.com|tiktokcdn\-eu\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(kwai\-pro\.com|tiktokv\.eu|dailymotion\.com|kwai\.net|capcut\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(fast\.com|byteglb\.com|bamgrid\.com|primevideo\.com|kick\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tubi\.io|tiktok\.tps\.dv\.tech|disneyplus\.com|max\.com|paramountplus\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(amemv\.com|inkuai\.com|kwai\.com|xiaohongshu\.com|zijieapi\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(douyin\.com|samsungcloud\.tv|kwaipros\.com|tiktokrow\-cdn\.com|play\.mercadolibre\.com\.mx)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(douyinliving\.com|mythad\.com|kslawin\.com|pluto\.tv|ap4r\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(adaether\.com|douyinvod\.com|aiv\-delivery\.net|indazn\.com|plex\.tv)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(discomax\.com|peacocktv\.com|yximgs\.com|hbomax\.com|mydramawave\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(crunchyroll\.com|xxpkg\.com|rumble\.com|snssdk\.com|vimeocdn\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(kuaishou\.com|tiktokcdn\-eu\.com\.ttdns3\.com|ksapisrv\.com|douyinpic\.com|dssott\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(ttlivecdn\.com|jtvnw\.net|like\.video|tmtreader\.com|xhscdn\.com)$" type=NXDOMAIN comment="streaming"
