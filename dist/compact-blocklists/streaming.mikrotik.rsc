# RouterOS DNS static NXDOMAIN rules
/ip dns static add regexp="(^|\\.)(netflix\.com|nflxso\.net|nflximg\.com|nflxvideo\.net|ibyteimg\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(netflix\.net|byteoversea\.com|nflxext\.com|byteimg\.com|nflximg\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(netflix\.ca|nflxsearch\.net|netflix\.com\.edgesuite\.net|amazonaws\.com|youtube\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tv\.apple\.com|hls\-svod\.itunes\.apple\.com|googlevideo\.com|av\-na\.amazon\.com|atv\-ps\.amazon\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(atv\-ext\.amazon\.com|tv\.v\.aaplimg\.com|hls\-svod\-ve\.itunes\.g\.aaplimg\.com|hls\-svod\-aoc\-ve\.itunes\.g\.aaplimg\.com|pv\-cdn\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(youtu\.be|tiktok\.com|tiktokcdn\.com|amazonvideo\.com|vimeo\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tiktokv\.com|edgesuite\.net|ytimg\.com|youtube\-nocookie\.com|twitch\.tv)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(globalvideo\.cdn\.pandora\.intl\.xiaomi\.com|ttlivecdn\.com\.c\.bytefcdn\-oversea\.com|ttvnw\.net|yt3\.ggpht\.com|tiktokcdn\-us\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(byteoversea\.net|douyincdn\.com|plex\.direct|capcutapi\.com|tiktokcdn\-eu\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(kwai\-pro\.com|tiktokv\.eu|dailymotion\.com|kwai\.net|capcut\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(fast\.com|byteglb\.com|bamgrid\.com|primevideo\.com|tubi\.io)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(kick\.com|tiktok\.tps\.dv\.tech|disneyplus\.com|max\.com|paramountplus\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(amemv\.com|inkuai\.com|kwai\.com|xiaohongshu\.com|zijieapi\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(douyin\.com|samsungcloud\.tv|kwaipros\.com|tiktokrow\-cdn\.com|play\.mercadolibre\.com\.mx)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(douyinliving\.com|mythad\.com|pluto\.tv|kslawin\.com|oec\-im\-tt\-sg\.tiktokglobalshopv\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(ap4r\.com|adaether\.com|aiv\-delivery\.net|douyinvod\.com|indazn\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(discomax\.com|plex\.tv|peacocktv\.com|hbomax\.com|yximgs\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(mydramawave\.com|crunchyroll\.com|xxpkg\.com|snssdk\.com|rumble\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(vimeocdn\.com|kuaishou\.com|ksapisrv\.com|dssott\.com|xhscdn\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tiktokcdn\-eu\.com\.ttdns3\.com|douyinpic\.com|ttlivecdn\.com|jtvnw\.net|like\.video)$" type=NXDOMAIN comment="streaming"
