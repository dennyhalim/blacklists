# RouterOS DNS static NXDOMAIN rules
/ip dns static add regexp="(^|\\.)(amazonaws\.com|netflix\.com|tiktok\.com|spotify\.com|tiktokcdn\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tiktokv\.com|edgesuite\.net|nflxso\.net|ttlivecdn\.com\.c\.bytefcdn\-oversea\.com|nflximg\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tiktokcdn\-us\.com|douyincdn\.com|netflix\.net|nflxvideo\.net|ibyteimg\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(scdn\.co|tiktokv\.eu|tiktokcdn\-eu\.com|fast\.com|spotifycdn\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(star\.playback\.edge\.bamgrid\.com|disney\.playback\.edge\.bamgrid\.com|disneyplus\.com|tiktok\.tps\.dv\.tech|amemv\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(douyinvod\.com|tiktokrow\-cdn\.com|douyin\.com|zijieapi\.com|byteoversea\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(nflxext\.com|snssdk\.com|douyinpic\.com|ttlivecdn\.com|media\.dssott\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tiktokcdn\-eu\.com\.ttdns3\.com|byteimg\.com|hotstar\.com|pstatp\.com|byspotify\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(douyinliving\.com|nflximg\.net|musical\.ly|douyinstatic\.com|disney\-plus\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(spoti\.fi|bytescm\.com|bytedapm\.com|bytecdn\.cn|bytegoofy\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(disneynow\.com|netflixtechblog\.com|muscdn\.com|pscdn\.co|bdurl\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(netflix\.ca|huoshan\.com|starplus\.com|nflxsearch\.net|spotify\.design)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(spotifycdn\.net|spotifyjobs\.com|huoshanzhibo\.com|spotifycodes\.com|huoshanstatic\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(spotifycharts\.com|netflixdnstest1\.com|netflixdnstest2\.com|netflixdnstest3\.com|netflixdnstest4\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(netflixdnstest5\.com|netflixdnstest6\.com|netflixdnstest7\.com|netflixdnstest8\.com|netflixdnstest9\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(netflixinvestor\.com|netflixdnstest10\.com|spotifyforbrands\.com|spotify\-everywhere\.com|p16\-tiktokcdn\-com\.akamaized\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(audio\-ak\-spotify\-com\.akamaized\.net|heads\-ak\-spotify\-com\.akamaized\.net|audio4\-ak\-spotify\-com\.akamaized\.net|heads4\-ak\-spotify\-com\.akamaized\.net|spotify\.map\.fastly\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(bytedance\.map\.fastly\.net|spotify\.map\.fastlylb\.net|netflix\.com\.edgesuite\.net|spotify\.com\.edgesuite\.net)$" type=NXDOMAIN comment="streaming"
