# RouterOS DNS static NXDOMAIN rules
/ip dns static add regexp="(^|\\.)(facebook\\.com|youtube\\.com|instagram\\.com|fbcdn\\.net|googlevideo\\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(netflix\\.com|youtu\\.be|tiktok\\.com|spotify\\.com|tiktokcdn\\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(tiktokv\\.com|vimeo\\.com|amazonvideo\\.com|cdninstagram\\.com|ytimg\\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(nflxso\\.net|soundcloud\\.com|youtube\-nocookie\\.com|twitch\\.tv|ttvnw\\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(nflxvideo\\.net|scdn\\.co|dailymotion\\.com|spotifycdn\\.com|primevideo\\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(bamgrid\\.com|disneyplus\\.com|deezer\\.com|hulu\\.com|iheart\\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(nflxext\\.com|vimeocdn\\.com|tidal\\.com|jtvnw\\.net|dssott\\.com)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(dmcdn\\.net|sndcdn\\.com|tunein\\.com|nflximg\\.net|dzcdn\\.net)$" type=NXDOMAIN comment="streaming"
/ip dns static add regexp="(^|\\.)(iheartmedia\\.com|huluim\\.com)$" type=NXDOMAIN comment="streaming"
