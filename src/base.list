#ads, trackers, common blocks
#avoid contains with <4 chars. less specific mean more false positive.
#keep regex short for mikrotik had limits
#domain:example.com
#prefix:steam
#endswith:ads
#label:pixel
contains:casino|poker|bingo|slots|gambl|adult|lgbt|xxx|porn|sexy|webcam
contains:doubleclick|booru|2mdn|pagead2|quantserve|xhamster
contains:analyti|telemetry|beacon|tracking|trafficmanager|nexusrules|piwik
suffix:.top|.cfd|.icu|.bet|.bid
suffix:.cam|.tube|.gay|.gq|.sex
regex:google(ad|tag|syndication|-analytic)
regex:ad(serv|system|-delivery|nxs|vert|mob|zerk|tube)
regex:(bing|mail-|search|image|video|moat|tv)ads
#regex:ads(flame|keeper|ports|2live|tat|min|co)
