#ads, trackers, common blocks
#avoid contains with <4 chars. less specific mean more false positive.
#keep regex short for mikrotik had limits
#domain:example.com
#prefix:steam
#endswith:ads
#label:pixel
contains:casino|poker|bingo|slots|gambl|adult|lgbt|xxx|porn|sexy|webcam
contains:mail-ads|ahcdn|xnxx|xhamster|booru|adserv|adsystem
contains:adnxs|taboola|showads|adroll|admanmedia|adrta|adsco|partnerads|pubmatic
contains:doubleclick|2mdn|pagead2|quantserve|hotjar|lijit|criteo|adriver|openx
contains:analytics|telemetry|beacon|tracking|trafficmanager|nexusrules|piwik
contains:smetric|sstats|actonservice|iberostar|insights
suffix:.top|.cfd|.icu|.bid|.cf|.ml
suffix:.cam|.tube|.gay|.gq|.sex|.bet
regex:google(ad|tag|syndication|-analytic)
regex:ad(-delivery||vert|mob|zerk|tube)
regex:(bing|mail-|search|image|video|moat|tv)ads
#regex:ads(flame|keeper|ports|2live|tat|min|co)
regex:a8(cv|clk|trk|track|click|tag)
